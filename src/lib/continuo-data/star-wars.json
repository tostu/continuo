  "plotPoints": [
    {
      "id": "episode-iv-0",
      "workSlug": "episode-iv",
      "characterId": "luke",
      "arcId": "iv-held",
      "at": 18,
      "text": "Findet Leias Hilferuf im Speicher von R2-D2."
    },
    {
      "id": "episode-iv-1",
      "workSlug": "episode-iv",
      "characterId": "luke",
      "arcId": "iv-held",
      "at": 35,
      "text": "Verliert sein Zuhause und schließt sich Obi-Wan an."
    },
    {
      "id": "episode-iv-2",
      "workSlug": "episode-iv",
      "characterId": "luke",
      "arcId": "iv-rebellion",
      "at": 48,
      "text": "Sucht mit Obi-Wan in Mos Eisley einen Piloten."
    },
    {
      "id": "episode-iv-3",
      "workSlug": "episode-iv",
      "characterId": "luke",
      "arcId": "iv-imperium",
      "at": 75,
      "text": "Befreit Leia aus dem Zellenblock des Todessterns."
    },
    {
      "id": "episode-iv-4",
      "workSlug": "episode-iv",
      "characterId": "luke",
      "arcId": "iv-rebellion",
      "at": 112,
      "text": "Fliegt den entscheidenden Angriff auf den Todesstern."
    },
    {
      "id": "episode-iv-5",
      "workSlug": "episode-iv",
      "characterId": "leia",
      "arcId": "iv-rebellion",
      "at": 2,
      "text": "Versteckt die gestohlenen Pläne in R2-D2."
    },
    {
      "id": "episode-iv-6",
      "workSlug": "episode-iv",
      "characterId": "leia",
      "arcId": "iv-imperium",
      "at": 40,
      "text": "Hält im Verhör stand – trotz Drohung gegen Alderaan."
    },
    {
      "id": "episode-iv-7",
      "workSlug": "episode-iv",
      "characterId": "leia",
      "arcId": "iv-held",
      "at": 78,
      "text": "Übernimmt bei der eigenen Rettung das Kommando."
    },
    {
      "id": "episode-iv-8",
      "workSlug": "episode-iv",
      "characterId": "leia",
      "arcId": "iv-rebellion",
      "at": 118,
      "text": "Ehrt die Helden nach der Schlacht von Yavin."
    },
    {
      "id": "episode-iv-9",
      "workSlug": "episode-iv",
      "characterId": "han",
      "arcId": "iv-rebellion",
      "at": 50,
      "text": "Nimmt den Flug nach Alderaan gegen hohen Lohn an."
    },
    {
      "id": "episode-iv-10",
      "workSlug": "episode-iv",
      "characterId": "han",
      "arcId": "iv-imperium",
      "at": 55,
      "text": "Entkommt mit dem Falken der imperialen Blockade."
    },
    {
      "id": "episode-iv-11",
      "workSlug": "episode-iv",
      "characterId": "han",
      "arcId": "iv-held",
      "at": 108,
      "text": "Kehrt im letzten Moment zur Schlacht zurück."
    },
    {
      "id": "episode-iv-12",
      "workSlug": "episode-iv",
      "characterId": "vader",
      "arcId": "iv-imperium",
      "at": 4,
      "text": "Entert das Rebellenschiff und sucht die Pläne."
    },
    {
      "id": "episode-iv-13",
      "workSlug": "episode-iv",
      "characterId": "vader",
      "arcId": "iv-held",
      "at": 88,
      "text": "Trifft seinen alten Meister wieder."
    },
    {
      "id": "episode-iv-14",
      "workSlug": "episode-iv",
      "characterId": "vader",
      "arcId": "iv-imperium",
      "at": 110,
      "text": "Verfolgt die Angreifer im Graben persönlich."
    },
    {
      "id": "episode-iv-15",
      "workSlug": "episode-iv",
      "characterId": "obi-wan",
      "arcId": "iv-held",
      "at": 30,
      "text": "Erzählt Luke von dessen Vater und dem Lichtschwert."
    },
    {
      "id": "episode-iv-16",
      "workSlug": "episode-iv",
      "characterId": "obi-wan",
      "arcId": "iv-rebellion",
      "at": 60,
      "text": "Schaltet den Traktorstrahl des Todessterns ab."
    },
    {
      "id": "episode-iv-17",
      "workSlug": "episode-iv",
      "characterId": "obi-wan",
      "arcId": "iv-held",
      "at": 88,
      "text": "Stellt sich Vader im Duell."
    },
    {
      "id": "episode-iv-18",
      "workSlug": "episode-iv",
      "characterId": "r2-d2",
      "arcId": "iv-rebellion",
      "at": 8,
      "text": "Flieht mit den Plänen auf den Wüstenplaneten."
    },
    {
      "id": "episode-iv-19",
      "workSlug": "episode-iv",
      "characterId": "r2-d2",
      "arcId": "iv-held",
      "at": 22,
      "text": "Macht sich allein auf die Suche nach Obi-Wan."
    },
    {
      "id": "episode-iv-20",
      "workSlug": "episode-iv",
      "characterId": "r2-d2",
      "arcId": "iv-rebellion",
      "at": 105,
      "text": "Fliegt als Astromech hinter Luke in die Schlacht."
    },
    {
      "id": "episode-iv-21",
      "workSlug": "episode-iv",
      "characterId": "c-3po",
      "arcId": "iv-rebellion",
      "at": 10,
      "text": "Landet mit R2-D2 in einer Rettungskapsel auf Tatooine."
    },
    {
      "id": "episode-iv-22",
      "workSlug": "episode-iv",
      "characterId": "c-3po",
      "arcId": "iv-imperium",
      "at": 80,
      "text": "Hält im Kontrollraum die Stellung."
    },
    {
      "id": "episode-iv-23",
      "workSlug": "episode-iv",
      "characterId": "tarkin",
      "arcId": "iv-imperium",
      "at": 38,
      "text": "Demonstriert die Macht der Station an Alderaan."
    },
    {
      "id": "episode-iv-24",
      "workSlug": "episode-iv",
      "characterId": "tarkin",
      "arcId": "iv-imperium",
      "at": 114,
      "text": "Lehnt die Evakuierung der Station ab."
    },
    {
      "id": "episode-iv-25",
      "workSlug": "episode-iv",
      "characterId": "chewbacca",
      "arcId": "iv-rebellion",
      "at": 50,
      "text": "Fliegt mit Han den Millennium Falken."
    },
    {
      "id": "episode-iv-26",
      "workSlug": "episode-iv",
      "characterId": "chewbacca",
      "arcId": "iv-imperium",
      "at": 70,
      "text": "Spielt den Gefangenen, um in den Zellenblock zu kommen."
    },
    {
      "id": "the-mandalorian-0",
      "workSlug": "the-mandalorian",
      "characterId": "din",
      "arcId": "m-gilde",
      "at": 1,
      "text": "Nimmt einen ungewöhnlichen Auftrag des Klienten an."
    },
    {
      "id": "the-mandalorian-1",
      "workSlug": "the-mandalorian",
      "characterId": "din",
      "arcId": "m-kind",
      "at": 1,
      "text": "Findet sein Ziel – und es ist ein Kind."
    },
    {
      "id": "the-mandalorian-2",
      "workSlug": "the-mandalorian",
      "characterId": "din",
      "arcId": "m-gilde",
      "at": 3,
      "text": "Liefert ab, bereut es und holt das Kind zurück."
    },
    {
      "id": "the-mandalorian-3",
      "workSlug": "the-mandalorian",
      "characterId": "din",
      "arcId": "m-kind",
      "at": 4,
      "text": "Sucht auf Sorgan ein Versteck für das Kind."
    },
    {
      "id": "the-mandalorian-4",
      "workSlug": "the-mandalorian",
      "characterId": "din",
      "arcId": "m-gideon",
      "at": 7,
      "text": "Kehrt nach Nevarro zurück, um den Klienten zu stellen."
    },
    {
      "id": "the-mandalorian-5",
      "workSlug": "the-mandalorian",
      "characterId": "din",
      "arcId": "m-kind",
      "at": 8,
      "text": "Nimmt den Auftrag an, das Kind zu seinesgleichen zu bringen."
    },
    {
      "id": "the-mandalorian-6",
      "workSlug": "the-mandalorian",
      "characterId": "grogu",
      "arcId": "m-kind",
      "at": 1,
      "text": "Wird im Lager der Nikto entdeckt."
    },
    {
      "id": "the-mandalorian-7",
      "workSlug": "the-mandalorian",
      "characterId": "grogu",
      "arcId": "m-kind",
      "at": 2,
      "text": "Hebt mit der Macht einen Mudhorn an."
    },
    {
      "id": "the-mandalorian-8",
      "workSlug": "the-mandalorian",
      "characterId": "grogu",
      "arcId": "m-gideon",
      "at": 7,
      "text": "Wird von Sturmtruppen entführt."
    },
    {
      "id": "the-mandalorian-9",
      "workSlug": "the-mandalorian",
      "characterId": "greef",
      "arcId": "m-gilde",
      "at": 1,
      "text": "Vermittelt Din den Auftrag."
    },
    {
      "id": "the-mandalorian-10",
      "workSlug": "the-mandalorian",
      "characterId": "greef",
      "arcId": "m-gilde",
      "at": 3,
      "text": "Führt die Gilde gegen Din an."
    },
    {
      "id": "the-mandalorian-11",
      "workSlug": "the-mandalorian",
      "characterId": "greef",
      "arcId": "m-gideon",
      "at": 7,
      "text": "Bietet Din einen Deal an – mit Hintergedanken."
    },
    {
      "id": "the-mandalorian-12",
      "workSlug": "the-mandalorian",
      "characterId": "cara",
      "arcId": "m-kind",
      "at": 4,
      "text": "Trifft Din auf Sorgan im Zweikampf."
    },
    {
      "id": "the-mandalorian-13",
      "workSlug": "the-mandalorian",
      "characterId": "cara",
      "arcId": "m-gideon",
      "at": 7,
      "text": "Schließt sich dem Plan für Nevarro an."
    },
    {
      "id": "the-mandalorian-14",
      "workSlug": "the-mandalorian",
      "characterId": "gideon",
      "arcId": "m-gideon",
      "at": 7,
      "text": "Umstellt die Cantina auf Nevarro."
    },
