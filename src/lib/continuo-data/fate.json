  "plotPoints": [
    {
      "id": "pp-stay-night-1",
      "workSlug": "fate-stay-night-2006",
      "characterId": "shirou-emiya-fsn",
      "arcId": "stay-night-fate-route",
      "at": 1,
      "text": "Shirou Emiya wird ungewollt in den fünften Heiligen Gralkrieg gezogen und beschwört Saber."
    },
    {
      "id": "pp-zero-1",
      "workSlug": "fate-zero",
      "characterId": "kiritsugu-emiya",
      "arcId": "zero-fourth-war",
      "at": 1,
      "text": "Kiritsugu Emiya kämpft als Meister von Saber im vierten Heiligen Gralkrieg um den Gral."
    },
    {
      "id": "pp-proto-1",
      "workSlug": "fate-prototype",
      "characterId": "arthur-pendragon-proto",
      "arcId": "proto-tokyo-1991",
      "at": 1,
      "text": "Arthur Pendragon kämpft im Tokio-Gralkrieg von 1991 an der Seite von Manaka Sajyou."
    },
    {
      "id": "pp-prisma-illya-1",
      "workSlug": "fate-kaleid-liner-prisma-illya",
      "characterId": "illya-kaleid",
      "arcId": "prisma-illya-transformation",
      "at": 1,
      "text": "Illyasviel wird von Magical Ruby zur Kaleidscope-Magical-Girl gemacht und muss Klassenkarten sammeln."
    },
    {
      "id": "pp-ubw-1",
      "workSlug": "fate-stay-night-unlimited-blade-works",
      "characterId": "rin-tohsaka",
      "arcId": "ubw-route",
      "at": 1,
      "text": "Rin Tohsaka führt Shirou durch ihre Route des Gralkriegs und stellt ihn Archer gegenüber."
    },
    {
      "id": "pp-apocrypha-1",
      "workSlug": "fate-apocrypha",
      "characterId": "sieg-apocrypha",
      "arcId": "apocrypha-great-war",
      "at": 1,
      "text": "Der Homunculus Sieg entkommt als Ersatz-Servant der Roten Fraktion und sucht seinen eigenen Weg."
    },
    {
      "id": "pp-oath-1",
      "workSlug": "fate-kaleid-liner-prisma-illya-oath-under-snow",
      "characterId": "miyu-edelfelt-oath",
      "arcId": "prisma-oath-shirou",
      "at": 45,
      "text": "Shirou Emiya gewinnt den Ainsworth-Gralkrieg in einer einzigen Nacht, um Miyu in eine andere Welt zu retten."
    },
    {
      "id": "pp-hf1-1",
      "workSlug": "fate-heavens-feel-1-presage-flower",
      "characterId": "sakura-matou-hf",
      "arcId": "hf-1-shadow",
      "at": 10,
      "text": "Sakura Matous dunkles Geheimnis beginnt Shirous Welt zu erschüttern."
    },
    {
      "id": "pp-lostroom-1",
      "workSlug": "fate-grand-order-moonlight-lostroom",
      "characterId": "ritsuka-fujimaru",
      "arcId": "fgo-lostbelt-prologue",
      "at": 5,
      "text": "Ritsuka Fujimaru und Mash Kyrielight entdecken zu Weihnachten Chaldeas verborgenen 'Lost Room'."
    },
    {
      "id": "pp-gohan-1",
      "workSlug": "todays-menu-for-the-emiya-family",
      "characterId": "shirou-emiya-gohan",
      "arcId": "gohan-alltag",
      "at": 1,
      "text": "Shirou kocht ein saisonales Gericht und bringt Rin, Sakura und Taiga an einen gemeinsamen Tisch."
    },
    {
      "id": "pp-hf2-1",
      "workSlug": "fate-heavens-feel-2-lost-butterfly",
      "characterId": "shirou-emiya-hf",
      "arcId": "hf-2-corruption",
      "at": 60,
      "text": "Shirou nimmt Angra Mainyus Makel in sich auf, um Sakura zu retten."
    },
    {
      "id": "pp-babylonia-1",
      "workSlug": "fate-grand-order-babylonia",
      "characterId": "mash-kyrielight",
      "arcId": "babylonia-singularity",
      "at": 3,
      "text": "Mash Kyrielight begleitet den Meister ins alte Uruk, die erste verlorene Singularität."
    },
    {
      "id": "pp-hf3-1",
      "workSlug": "fate-heavens-feel-3-spring-song",
      "characterId": "illyasviel-hf",
      "arcId": "hf-3-finale",
      "at": 90,
      "text": "Illyasviel von Einzbern opfert sich im finalen Kampf um Sakuras Erlösung."
    },
    {
      "id": "pp-camelot-1",
      "workSlug": "fate-grand-order-camelot",
      "characterId": "lancelot-camelot",
      "arcId": "camelot-round-table",
      "at": 30,
      "text": "Lancelot verteidigt als Wahnsinniger Ritter die Tafelrunde gegen Chaldeas Meister."
    }
