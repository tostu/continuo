# Cloudflare D1 – wird nur beim Build (Prerendering) und von drizzle-kit gelesen.
# Token: Cloudflare-Dashboard → API Tokens → Berechtigung "D1: Edit" auf dem Account.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""
CLOUDFLARE_D1_TOKEN=""

# Lokale D1 (wrangler-State) statt der REST-API. Normalerweise leer lassen –
# `bun run dev:local` / `bun run build:local` setzen die Variable selbst.
D1_LOCAL=""

# Pfad zur lokalen miniflare-SQLite. Leer lassen = wird unter .wrangler/state/v3/d1
# gesucht, also genau die Datei, die `bun run db:migrate:local` anlegt.
D1_LOCAL_PATH=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

ORIGIN=""

# TMDb (themoviedb.org) – "API Read Access Token" (v4 auth), not the v3 API key
# Wird nur beim Build (Prerendering) gelesen; leer lassen = keine Poster/Fotos.
TMDB_API_READ_ACCESS_TOKEN=""

# Öffentliche Basis-URL der Seite, ohne Slash am Ende (z. B. https://continuo.app).
# Nötig für Canonical-Links, hreflang, og:url und sitemap.xml – solange leer,
# bleiben diese Angaben weg und die Sitemap ist leer.
PUBLIC_SITE_URL=""
